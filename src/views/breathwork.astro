---
import PageHero from "../components/page-hero.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  heroDesktopSrc: string;
  heroMobileSrc: string;
  content: CollectionEntry<"breathworkPage">["data"];
  sessions: CollectionEntry<"breathworkPricing">["data"][];
}

const { heroDesktopSrc, heroMobileSrc, content, sessions } = Astro.props;
---

<div class="min-h-screen">
  <PageHero
    desktopSrc={heroDesktopSrc}
    mobileSrc={heroMobileSrc}
    overlay="bg-purple-dark/50"
    eyebrow={content.hero_eyebrow}
    title={content.hero_title}
    subtitle={content.hero_subtitle}
  />

  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-semibold text-purple-dark text-center mb-16 motion-preset-slide-up motion-duration-700">
          {content.what_is_heading}
        </h2>

        {
          content.intro_blocks.map((block, index) => (
            <div
              class={`flex flex-col ${block.image_right ? "md:flex-row" : "md:flex-row-reverse"} items-center gap-10 ${index < content.intro_blocks.length - 1 ? "mb-16" : ""} motion-preset-slide-up motion-duration-700`}
              style={`--motion-delay:${(index + 1) * 100}ms`}
            >
              <div class="flex-1 text-muted-foreground">
                <h3 class="text-purple-dark mb-3">{block.title}</h3>
                <p>{block.body}</p>
              </div>
              <div class="w-full md:w-80 aspect-square rounded-2xl overflow-hidden flex-shrink-0">
                <img src={block.image} alt={block.image_alt} class="w-full h-full object-cover" />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {
            content.benefits.map((benefit, index) => (
              <div class="border border-orange p-8 rounded-2xl motion-preset-slide-up motion-duration-700" style={`--motion-delay:${index * 80}ms`}>
                <h3 class="text-orange-dark mb-3">{benefit.title}</h3>
                <p class="text-muted-foreground text-sm">{benefit.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-purple">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl md:text-4xl text-white text-center mb-12">{content.sessions_heading}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            sessions.map((session, index) => (
              <div class="bg-white p-8 rounded-2xl border border-soft-purple hover:shadow-lg transition-shadow flex flex-col motion-preset-slide-up motion-duration-700" style={`--motion-delay:${index * 80}ms`}>
                <div class="flex flex-col flex-1">
                  <div class="flex-1">
                    <h3 class="text-2xl text-purple-dark mb-2">{session.name}</h3>
                    <div class="flex flex-wrap gap-4 mb-4 text-sm text-muted-foreground">
                      Duration: <span>{session.duration ?? "-"}</span>
                    </div>
                  </div>

                  <div class="flex items-center justify-between w-full">
                    <div class="text-3xl text-purple">{session.price}</div>
                    <a
                      href={session.cta_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="bg-orange text-white px-6 py-2 rounded-full hover:bg-orange-light transition-colors"
                    >
                      Buy Now
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-semibold text-purple-dark text-center mb-12">{content.expect_heading}</h2>
        <div class="flex flex-col md:flex-row md:space-x-8 space-y-6 md:space-y-0">
          {
            content.expectations.map((item) => (
              <div class="bg-mist p-8 rounded-2xl flex-1">
                <h3 class="text-purple-dark mb-3">{item.title}</h3>
                <p class="text-muted-foreground">{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</div>
