---
import PageHero from "../components/page-hero.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  heroDesktopSrc: string;
  heroMobileSrc?: string;
  content: CollectionEntry<"coldPlungePage">["data"];
  options: CollectionEntry<"coldPlungePricing">["data"][];
}

const { heroDesktopSrc, heroMobileSrc, content, options } = Astro.props;
---

<div class="min-h-screen">
  <PageHero
    desktopSrc={heroDesktopSrc}
    mobileSrc={heroMobileSrc}
    overlay="bg-black/50"
    eyebrow={content.hero_eyebrow}
    title={content.hero_title}
    subtitle={content.hero_subtitle}
  />

  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16 motion-preset-slide-up motion-duration-700">
          <h2 class="text-4xl font-semibold text-purple-dark mb-6">{content.science_heading}</h2>
          <p class="text-lg text-muted-foreground max-w-3xl mx-auto">
            {content.science_intro}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            content.benefits.map((benefit, index) => (
              <div class="border border-orange p-6 rounded-2xl motion-preset-slide-up motion-duration-700" style={`--motion-delay:${index * 60}ms`}>
                <h4 class="text-purple-dark mb-2">{benefit.title}</h4>
                <p class="text-sm text-muted-foreground">{benefit.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-warm-cream">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-4xl font-semibold text-purple-dark text-center mb-12">{content.options_heading}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            options.map((option, index) => (
              <div class="bg-white p-8 rounded-2xl border border-soft-purple hover:shadow-lg transition-shadow relative motion-preset-slide-up motion-duration-700" style={`--motion-delay:${index * 80}ms`}>
                {
                  option.badge && (
                    <div class="absolute -top-3 right-4 bg-sunset text-white px-3 py-1 rounded-full text-xs">
                      {option.badge}
                    </div>
                  )
                }
                <h3 class="text-purple-dark mb-3">{option.name}</h3>
                <p class="text-muted-foreground text-sm mb-6">{option.description}</p>
                <div class="text-3xl text-purple mb-6">{option.price}</div>
                <a
                  href={option.cta_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full block text-center bg-purple text-white py-3 rounded-full hover:bg-purple-light transition-colors"
                >
                  {content.options_cta_text}
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-4xl font-semibold text-purple text-center mb-8">{content.how_it_works_heading}</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          {
            content.steps.map((item, index) => (
              <div class="flex flex-col items-center text-center motion-preset-slide-up motion-duration-700" style={`--motion-delay:${index * 100}ms`}>
                <div class="w-16 h-16 rounded-full bg-soft-purple/40 flex items-center justify-center mb-5 shadow-sm text-purple font-bold text-xl">
                  {index + 1}
                </div>
                <h3 class="text-purple-dark font-semibold text-2xl mb-2">{item.title}</h3>
                <p class="text-muted-foreground text-sm leading-relaxed">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-warm-cream">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-4xl font-semibold text-purple text-center mb-8">{content.safety_heading}</h2>
        <div class="bg-white p-8 rounded-2xl border border-soft-purple">
          <p class="text-muted-foreground mb-6">
            {content.safety_intro}
          </p>
          <ul class="space-y-3 text-muted-foreground">
            {
              content.safety_points.map((point) => (
                <li class="flex items-start space-x-3"><span class="text-purple">•</span><span>{point}</span></li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</div>
