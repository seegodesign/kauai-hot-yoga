---
import PageHero from "../components/page-hero.astro";

export interface BlogPost {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  image?: string;
  tags: string[];
}

interface Props {
  posts: BlogPost[];
  heroDesktopSrc: string;
  heroMobileSrc: string;
}

const { posts, heroDesktopSrc, heroMobileSrc } = Astro.props;

function formatDate(date: Date) {
  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  }).format(date);
}
---

<div class="min-h-screen">
  <PageHero
    desktopSrc={heroDesktopSrc}
    mobileSrc={heroMobileSrc}
    overlay="bg-purple/65"
    eyebrow="Wellness & Inspiration"
    title="Our Blog"
    subtitle="Tips, stories, and guides to support your yoga journey."
  />

  <section class="py-12 md:py-24 bg-white">
    <div class="container mx-auto px-4">
      {
        posts.length === 0 ? (
          <p class="text-center text-muted-foreground text-lg">No posts yet - check back soon!</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
            {posts.map((post, index) => (
              <article class="motion-preset-slide-up motion-duration-700" style={`--motion-delay:${index * 80}ms`}>
                <a href={`/blog/${post.slug}`} class="group block h-full">
                  <div class="bg-white rounded-2xl border border-soft-purple overflow-hidden shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
                    {
                      post.image ? (
                        <div class="h-48 overflow-hidden">
                          <img
                            src={post.image}
                            alt={post.title}
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            loading="lazy"
                            width="800"
                            height="450"
                          />
                        </div>
                      ) : (
                        <div class="h-48 bg-gradient-to-br from-purple/20 to-orange/20 flex items-center justify-center">
                          <span class="text-lg text-purple-dark/60">No Image</span>
                        </div>
                      )
                    }

                    <div class="p-6 flex flex-col flex-1">
                      {
                        post.tags.length > 0 && (
                          <div class="flex flex-wrap gap-2 mb-3">
                            {post.tags.slice(0, 2).map((tag) => (
                              <span class="text-xs font-semibold text-orange uppercase tracking-wide">
                                {tag}
                              </span>
                            ))}
                          </div>
                        )
                      }

                      <h2 class="text-xl font-bold text-purple-dark mb-2 group-hover:text-purple transition-colors leading-snug">
                        {post.title}
                      </h2>

                      <p class="text-muted-foreground text-sm leading-relaxed mb-4 flex-1">
                        {post.description}
                      </p>

                      <div class="flex items-center justify-between mt-auto pt-4 border-t border-soft-purple">
                        <div class="text-xs text-muted-foreground">{formatDate(post.pubDate)}</div>
                        <span class="text-purple text-sm font-medium">Read more -></span>
                      </div>
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</div>
