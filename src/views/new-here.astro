---
import PageHero from "../components/page-hero.astro";

export interface NewHereContent {
  seo_title: string;
  seo_description: string;
  hero_eyebrow: string;
  hero_title: string;
  hero_subtitle: string;
  hero_cta_text: string;
  intro_offer_eyebrow: string;
  intro_offer_heading: string;
  intro_offer_badge: string;
  intro_offer_label: string;
  what_is_included_heading: string;
  included_features: string[];
  claim_offer_text: string;
  browse_schedule_text: string;
  how_it_works_eyebrow: string;
  how_it_works_heading: string;
  steps: { step: string; title: string; description: string; color: string }[];
  what_to_expect_eyebrow: string;
  what_to_expect_heading: string;
  expectations: { title: string; body: string }[];
  bottom_cta_heading: string;
  bottom_cta_body: string;
  bottom_cta_primary_text: string;
  bottom_cta_primary_href: string;
  bottom_cta_secondary_text: string;
}

interface Props {
  content: NewHereContent;
  heroDesktopSrc: string;
  heroMobileSrc: string;
  specialPrice: string;
  specialName: string;
  specialCtaUrl: string;
  phone: string;
  scheduleUrl: string;
}

const {
  content,
  heroDesktopSrc,
  heroMobileSrc,
  specialPrice,
  specialName,
  specialCtaUrl,
  phone,
  scheduleUrl,
} = Astro.props;
---

<div class="min-h-screen">
  <PageHero
    desktopSrc={heroDesktopSrc}
    mobileSrc={heroMobileSrc}
    overlay="bg-gradient-to-br from-purple-dark/80 via-purple/70 to-orange/40"
    eyebrow={content.hero_eyebrow}
    title={content.hero_title}
    subtitle={content.hero_subtitle}
  >
    <a
      href="#intro-offer"
      class="inline-block mt-8 bg-orange text-white font-semibold px-8 py-4 rounded-full hover:bg-orange-dark transition-colors shadow-lg motion-preset-slide-up motion-duration-700 motion-delay-200"
    >
      {content.hero_cta_text}
    </a>
  </PageHero>

  <section id="intro-offer" class="py-20 bg-gradient-to-br from-purple-dark to-purple scroll-mt-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <span class="inline-block text-orange-light font-semibold tracking-widest uppercase text-xs mb-3">
            {content.intro_offer_eyebrow}
          </span>
          <h2 class="text-4xl md:text-5xl font-bold text-white">{content.intro_offer_heading}</h2>
        </div>

        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-3xl p-8 md:p-12 text-white flex flex-col md:flex-row gap-10 items-center motion-preset-slide-up motion-duration-700">
          <div class="text-center md:text-left md:min-w-[200px]">
            <div class="inline-flex items-center gap-2 bg-orange/30 border border-orange/40 rounded-full px-4 py-1 text-xs font-bold uppercase tracking-widest text-orange-light mb-4">
              {content.intro_offer_badge}
            </div>
            <p class="text-white/70 text-sm font-semibold uppercase tracking-widest mb-1">{specialName}</p>
            <div class="text-7xl font-extrabold leading-none mb-2">{specialPrice}</div>
            <p class="text-white/60 text-sm">{content.intro_offer_label}</p>
          </div>

          <div class="hidden md:block w-px self-stretch bg-white/20"></div>
          <div class="md:hidden w-full h-px bg-white/20"></div>

          <div class="flex-1">
            <h3 class="text-xl font-bold mb-5">{content.what_is_included_heading}</h3>
            <ul class="space-y-3 mb-8">
              {content.included_features.map((f) => (
                <li class="flex items-start gap-3 text-white/85 text-sm"><span class="text-orange mt-0.5 shrink-0">✓</span>{f}</li>
              ))}
            </ul>
            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href={specialCtaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 text-center bg-orange text-white font-bold py-4 rounded-full hover:bg-orange-dark transition-colors"
              >
                {content.claim_offer_text}
              </a>
              <a
                href={scheduleUrl}
                class="flex-1 text-center border-2 border-white/40 text-white font-semibold py-4 rounded-full hover:bg-white/10 hover:border-white transition-colors"
              >
                {content.browse_schedule_text}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14">
          <span class="inline-block text-orange font-semibold tracking-widest uppercase text-sm mb-4">{content.how_it_works_eyebrow}</span>
          <h2 class="text-5xl md:text-6xl text-purple-dark">{content.how_it_works_heading}</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
          {content.steps.map((step, index) => (
            <div class="relative z-10 flex flex-col items-center text-center motion-preset-slide-up motion-duration-700" style={`--motion-delay:${index * 100}ms`}>
              <div class={`w-20 h-20 rounded-full bg-gradient-to-br ${step.color} flex items-center justify-center mb-5 shadow-lg`}>
                <span class="text-white text-2xl font-bold">{step.step}</span>
              </div>
              <div class="bg-white border border-soft-purple rounded-2xl p-6 shadow-sm w-full">
                <h4 class="text-purple-dark mb-2 text-base font-semibold">{step.title}</h4>
                <p class="text-sm text-muted-foreground leading-relaxed">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-warm-cream">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <span class="inline-block text-orange font-semibold tracking-widest uppercase text-sm mb-4">{content.what_to_expect_eyebrow}</span>
          <h2 class="text-4xl md:text-5xl text-purple-dark">{content.what_to_expect_heading}</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {content.expectations.map((item, i) => (
            <div class="bg-white rounded-2xl p-6 border border-soft-purple shadow-sm motion-preset-slide-up motion-duration-700" style={`--motion-delay:${i * 80}ms`}>
              <h4 class="text-purple-dark font-semibold mb-2">{item.title}</h4>
              <p class="text-sm text-muted-foreground leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-purple-dark mb-4">{content.bottom_cta_heading}</h2>
        <p class="text-muted-foreground mb-8">
          {content.bottom_cta_body}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={content.bottom_cta_primary_href}
            class="bg-purple text-white font-semibold px-8 py-3 rounded-full hover:bg-purple-dark transition-colors"
          >
            {content.bottom_cta_primary_text}
          </a>
          <a
            href={`tel:${phone.replace(/\D/g, "")}`}
            class="border-2 border-purple text-purple font-semibold px-8 py-3 rounded-full hover:bg-purple/5 transition-colors"
          >
            {content.bottom_cta_secondary_text}
          </a>
        </div>
      </div>
    </div>
  </section>
</div>
