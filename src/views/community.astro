---
import PageHero from "../components/page-hero.astro";

export interface CommunityMember {
  name: string;
  role: string;
  bio: string;
  photo?: string;
  photo_position?: string;
  website?: string;
  instagram?: string;
}

interface Props {
  members: CommunityMember[];
  heroDesktopSrc: string;
  heroMobileSrc: string;
}

const { members, heroDesktopSrc, heroMobileSrc } = Astro.props;
---

<div class="min-h-screen">
  <PageHero
    desktopSrc={heroDesktopSrc}
    mobileSrc={heroMobileSrc}
    overlay="bg-purple-dark/65"
    eyebrow="Our People"
    title="Community"
    subtitle="The friends, healers, guides, and collaborators who make Kauai Hot Yoga more than just a studio."
  />

  <section class="py-20 bg-warm-cream">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        {
          members.length === 0 ? (
            <p class="text-center text-muted-foreground text-lg">Community members coming soon.</p>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {members.map((member, index) => (
                <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-soft-purple flex flex-col motion-preset-slide-up motion-duration-700" style={`--motion-delay:${index * 70}ms`}>
                  <div class="relative h-96 bg-soft-purple overflow-hidden">
                    {
                      member.photo ? (
                        <img
                          src={member.photo}
                          alt={member.name}
                          class="w-full h-full object-cover"
                          style={`object-position:${member.photo_position ?? "center"}`}
                          loading="lazy"
                          width="400"
                          height="400"
                        />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-purple-light/30 to-orange/20">
                          <span class="text-6xl font-bold text-purple-dark/30">
                            {member.name.charAt(0)}
                          </span>
                        </div>
                      )
                    }
                    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-orange to-purple-light" />
                  </div>

                  <div class="p-7 flex flex-col flex-1">
                    <h3 class="text-purple-dark text-xl mb-1">{member.name}</h3>
                    {member.role && (
                      <p class="text-orange font-semibold text-sm uppercase tracking-wide mb-4">{member.role}</p>
                    )}
                    <p class="text-muted-foreground text-sm leading-relaxed flex-1">{member.bio}</p>

                    {(member.website || member.instagram) && (
                      <div class="flex items-center gap-4 mt-6 pt-5 border-t border-soft-purple text-sm">
                        {member.instagram && (
                          <a
                            href={member.instagram}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-purple hover:text-purple-light transition-colors"
                          >
                            Instagram
                          </a>
                        )}
                        {member.website && (
                          <a
                            href={member.website}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-purple hover:text-purple-light transition-colors"
                          >
                            Website
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>
</div>
