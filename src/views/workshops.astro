---
import PageHero from "../components/page-hero.astro";

interface WorkshopItem {
  title: string;
  date: string;
  time: string;
  instructor: string;
  capacity: string;
  price: string;
  description: string;
  image?: string;
}

interface WorkshopBenefit {
  title: string;
  body: string;
}

interface WorkshopsContent {
  hero_eyebrow: string;
  hero_title: string;
  hero_subtitle: string;
  reserve_button_text: string;
  reserve_button_href: string;
  workshops: WorkshopItem[];
  benefits_heading: string;
  benefits_intro: string;
  benefits: WorkshopBenefit[];
}

interface Props {
  content: WorkshopsContent;
  heroDesktopSrc: string;
  heroMobileSrc: string;
}

const { content, heroDesktopSrc, heroMobileSrc } = Astro.props;
---

<div class="min-h-screen">
  <PageHero
    desktopSrc={heroDesktopSrc}
    mobileSrc={heroMobileSrc}
    overlay="bg-purple-dark/50"
    eyebrow={content.hero_eyebrow}
    title={content.hero_title}
    subtitle={content.hero_subtitle}
  />

  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto space-y-8">
        {
          content.workshops.map((workshop, index) => (
            <div
              class="bg-white border border-soft-purple rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow motion-preset-slide-up motion-duration-700"
              style={`--motion-delay:${index * 60}ms`}
            >
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {workshop.image && (
                  <div class="h-64 lg:h-auto overflow-hidden">
                    <img
                      src={workshop.image}
                      alt={workshop.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      width="800"
                      height="533"
                    />
                  </div>
                )}

                <div
                  class={`p-8 ${workshop.image ? "lg:col-span-2" : "lg:col-span-3"}`}
                >
                  <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between mb-4">
                    <div>
                      <h3 class="text-purple-dark mb-2">{workshop.title}</h3>
                      <p class="text-muted-foreground text-sm mb-2">
                        with {workshop.instructor}
                      </p>
                    </div>
                    <div class="text-purple text-2xl lg:text-right mt-2 lg:mt-0">
                      {workshop.price}
                    </div>
                  </div>

                  <div class="flex flex-wrap gap-4 mb-4 text-sm text-muted-foreground">
                    <span>{workshop.date}</span>
                    <span>{workshop.time}</span>
                    <span>{workshop.capacity}</span>
                  </div>

                  <p class="text-muted-foreground mb-6">
                    {workshop.description}
                  </p>

                  <a
                    href={content.reserve_button_href}
                    class="inline-flex items-center bg-purple text-white px-8 py-3 rounded-full hover:bg-purple-light transition-colors"
                  >
                    {content.reserve_button_text}
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-20 bg-mist">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-purple-dark mb-6">{content.benefits_heading}</h2>
        <p class="text-muted-foreground mb-12">
          {content.benefits_intro}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {content.benefits.map((benefit) => (
            <div class="bg-white p-6 rounded-2xl border border-soft-purple">
              <h4 class="text-purple-dark mb-2">{benefit.title}</h4>
              <p class="text-sm text-muted-foreground">
                {benefit.body}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</div>
