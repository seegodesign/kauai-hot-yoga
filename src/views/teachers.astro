---
import PageHero from "../components/page-hero.astro";

export interface Teacher {
  name: string;
  title: string;
  bio: string;
  photo?: string;
  specialties: string[];
  instagram?: string;
}

interface Props {
  teachers: Teacher[];
  heroDesktopSrc: string;
  heroMobileSrc: string;
  heroEyebrow: string;
  heroTitle: string;
  heroSubtitle: string;
}

const { teachers, heroDesktopSrc, heroMobileSrc, heroEyebrow, heroTitle, heroSubtitle } = Astro.props;
---

<div class="min-h-screen">
  <PageHero
    desktopSrc={heroDesktopSrc}
    mobileSrc={heroMobileSrc}
    overlay="bg-purple-dark/70"
    eyebrow={heroEyebrow}
    title={heroTitle}
    subtitle={heroSubtitle}
  />

  <section class="py-12 md:py-24 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 max-w-6xl mx-auto">
        {
          teachers.map((teacher, index) => (
            <div class="flex flex-col motion-preset-slide-up motion-duration-700" style={`--motion-delay:${index * 70}ms`}>
              <div class="relative mb-6 rounded-2xl overflow-hidden aspect-[3/4] bg-gradient-to-br from-soft-purple to-purple/20">
                {
                  teacher.photo ? (
                    <img
                      src={teacher.photo}
                      alt={teacher.name}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      width="400"
                      height="533"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <span class="text-7xl font-bold text-purple/30">{teacher.name.charAt(0)}</span>
                    </div>
                  )
                }

                {
                  teacher.instagram && (
                    <a
                      href={teacher.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="absolute bottom-3 right-3 px-3 py-1.5 rounded-full bg-white/90 backdrop-blur-sm text-sm hover:bg-white transition-colors shadow text-purple-dark"
                    >
                      Instagram
                    </a>
                  )
                }
              </div>

              <div>
                <h2 class="text-xl font-bold text-purple-dark mb-0.5">{teacher.name}</h2>
                {teacher.title && (
                  <p class="text-orange font-semibold text-xs uppercase tracking-widest mb-3">{teacher.title}</p>
                )}
                <p class="text-muted-foreground text-sm leading-relaxed mb-4">{teacher.bio}</p>

                {
                  teacher.specialties.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {teacher.specialties.map((s) => (
                        <span class="text-xs px-3 py-1 rounded-full bg-soft-purple text-purple-dark font-medium">
                          {s}
                        </span>
                      ))}
                    </div>
                  )
                }
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-20 bg-warm-cream">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-purple-dark mb-4">Interested in Teaching With Us?</h2>
      <p class="text-muted-foreground mb-8 max-w-lg mx-auto">
        We are always looking for passionate, certified yoga instructors to join our ohana. Reach
        out and introduce yourself.
      </p>
      <a
        href="/contact-us"
        class="inline-block bg-purple text-white font-semibold px-8 py-3 rounded-full hover:bg-purple-dark transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </section>
</div>
