---
import PageHero from "../components/page-hero.astro";

export interface GiftCardContent {
  seo_title: string;
  seo_description: string;
  hero_eyebrow: string;
  hero_title: string;
  hero_subtitle: string;
  hero_cta_text: string;
  purchase_url: string;
  section_eyebrow: string;
  section_heading: string;
  section_body: string;
  cards: { name: string; price: string; description: string; highlight: boolean }[];
  bottom_cta_heading: string;
  bottom_cta_body: string;
  bottom_cta_button_text: string;
}

interface Props {
  content: GiftCardContent;
  heroDesktopSrc: string;
  heroMobileSrc: string;
}

const { content, heroDesktopSrc, heroMobileSrc } = Astro.props;
---

<div class="min-h-screen">
  <PageHero
    desktopSrc={heroDesktopSrc}
    mobileSrc={heroMobileSrc}
    overlay="bg-gradient-to-br from-purple-dark/80 via-purple/70 to-orange/40"
    eyebrow={content.hero_eyebrow}
    title={content.hero_title}
    subtitle={content.hero_subtitle}
  >
    <a
      href={content.purchase_url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 mt-8 bg-orange text-white font-semibold px-8 py-4 rounded-full hover:bg-orange-dark transition-colors shadow-lg motion-preset-slide-up motion-duration-700 motion-delay-200"
    >
      {content.hero_cta_text}
    </a>
  </PageHero>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14">
        <span class="inline-block text-orange font-semibold tracking-widest uppercase text-sm mb-3">
          {content.section_eyebrow}
        </span>
        <h2 class="text-4xl font-bold text-purple-dark mb-4">{content.section_heading}</h2>
        <p class="text-purple-dark/65 max-w-xl mx-auto">
          {content.section_body}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {
          content.cards.map((card, i) => (
            <a
              href={content.purchase_url}
              target="_blank"
              rel="noopener noreferrer"
              class={`group relative rounded-2xl p-6 border-2 flex flex-col gap-3 hover:shadow-xl transition-all motion-preset-slide-up motion-duration-700 ${
                card.highlight
                  ? "border-orange bg-orange/5 hover:border-orange-dark"
                  : "border-soft-purple bg-white hover:border-purple"
              }`}
              style={`--motion-delay:${i * 60}ms`}
            >
              {
                card.highlight && (
                  <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-orange text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">
                    Popular
                  </span>
                )
              }

              <div>
                <p class="font-bold text-purple-dark text-lg leading-tight">{card.price}</p>
                <p class="text-sm text-purple-dark/60 font-medium">{card.name}</p>
              </div>

              <p class="text-sm text-purple-dark/65 leading-relaxed flex-1">{card.description}</p>

              <span class="text-sm font-semibold text-orange">Buy now -></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-20 bg-gradient-to-br from-purple-dark to-purple text-center">
    <div class="container mx-auto px-4 max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        {content.bottom_cta_heading}
      </h2>
      <p class="text-white/75 mb-8 text-lg">
        {content.bottom_cta_body}
      </p>
      <a
        href={content.purchase_url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-orange text-white font-semibold px-10 py-4 rounded-full hover:bg-orange-dark transition-colors shadow-lg text-lg"
      >
        {content.bottom_cta_button_text}
      </a>
    </div>
  </section>
</div>
