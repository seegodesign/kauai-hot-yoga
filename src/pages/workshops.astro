---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkshopsPage from "../views/workshops.astro";

const pageHeroesEntry = await getEntry("pageHeroSettings", "main");
if (!pageHeroesEntry) throw new Error("Missing content: pageHeroSettings/main.yml");
---

<BaseLayout
  title="Yoga Workshops in Kauai, Hawaii | Kauai Hot Yoga"
  description="Deepen your practice with specialized yoga workshops and wellness events at Kauai Hot Yoga in Lihue, Hawaii. Open to all levels."
  ogImage="/images/workshops-hero.webp"
  currentPath="/workshops">
  <WorkshopsPage heroDesktopSrc={pageHeroesEntry.data.workshops.desktop} heroMobileSrc={pageHeroesEntry.data.workshops.mobile} />
</BaseLayout>