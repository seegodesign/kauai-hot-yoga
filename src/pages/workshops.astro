---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkshopsPage from "../views/workshops.astro";

const workshopsEntries = await getCollection("workshopsPage");
const workshopsEntry = workshopsEntries[0];
if (!workshopsEntry) throw new Error("Missing content: workshopsPage collection is empty");

const pageHeroesEntry = await getEntry("pageHeroSettings", "main");
if (!pageHeroesEntry) throw new Error("Missing content: pageHeroSettings/main.yml");
---

<BaseLayout
  title={workshopsEntry.data.seo_title}
  description={workshopsEntry.data.seo_description}
  ogImage="/images/workshops-hero.webp"
  currentPath="/workshops">
  <WorkshopsPage
    content={workshopsEntry.data}
    heroDesktopSrc={pageHeroesEntry.data.workshops.desktop}
    heroMobileSrc={pageHeroesEntry.data.workshops.mobile}
  />
</BaseLayout>