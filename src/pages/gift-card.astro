---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import GiftCardPage from "../views/gift-card.astro";

const pageHeroesEntry = await getEntry("pageHeroSettings", "main");
if (!pageHeroesEntry) throw new Error("Missing content: pageHeroSettings/main.yml");

const pageContentEntry = await getEntry("giftCardPage", "main");
if (!pageContentEntry) throw new Error("Missing content: giftCardPage/main.yml");
---

<BaseLayout
  title={pageContentEntry.data.seo_title}
  description={pageContentEntry.data.seo_description}
  ogImage="/images/studio-interior.webp"
  currentPath="/gift-card">
  <GiftCardPage
    content={pageContentEntry.data}
    heroDesktopSrc={pageHeroesEntry.data.gift_card.desktop}
    heroMobileSrc={pageHeroesEntry.data.gift_card.mobile}
  />
</BaseLayout>
