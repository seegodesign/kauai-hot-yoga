---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CommunityPage from "../views/community.astro";

const communityEntries = await getCollection("community");
const members = communityEntries
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((e) => e.data);

const pageHeroesEntry = await getEntry("pageHeroSettings", "main");
if (!pageHeroesEntry) throw new Error("Missing content: pageHeroSettings/main.yml");

const pageContentEntry = await getEntry("communityPage", "main");
if (!pageContentEntry) throw new Error("Missing content: communityPage/main.yml");
---

<BaseLayout
  title={pageContentEntry.data.seo_title || "Community | Kauai Hot Yoga"}
  description={pageContentEntry.data.seo_description || "Meet the local practitioners, healers, and guides who are part of the Kauai Hot Yoga community in Lihue, Hawaii."}
  currentPath="/our-community">
  <CommunityPage
    members={members}
    heroDesktopSrc={pageHeroesEntry.data.community.desktop}
    heroMobileSrc={pageHeroesEntry.data.community.mobile}
    heroEyebrow={pageContentEntry.data.hero_eyebrow}
    heroTitle={pageContentEntry.data.hero_title}
    heroSubtitle={pageContentEntry.data.hero_subtitle}
  />
</BaseLayout>