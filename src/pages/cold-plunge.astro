---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ColdPlungePage } from "../views/cold-plunge";

const pageHeroesEntry = await getEntry("pageHeroSettings", "main");
if (!pageHeroesEntry) throw new Error("Missing content: pageHeroSettings/main.yml");
---

<BaseLayout
  title="Cold Plunge | Kauai Hot Yoga"
  description="Ice bath therapy and cold plunge sessions for recovery, inflammation reduction, and mental clarity in Kauai."
  ogImage="/images/cold-plunge-hero.webp"
  currentPath="/cold-plunge">
  <ColdPlungePage heroDesktopSrc={pageHeroesEntry.data.cold_plunge.desktop} client:visible />
</BaseLayout>