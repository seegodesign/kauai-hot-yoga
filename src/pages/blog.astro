---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPage from "../views/blog.astro";

const pageHeroesEntry = await getEntry("pageHeroSettings", "main");
if (!pageHeroesEntry) throw new Error("Missing content: pageHeroSettings/main.yml");

const pageContentEntry = await getEntry("blogPage", "main");
if (!pageContentEntry) throw new Error("Missing content: blogPage/main.yml");

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((p) => ({
    slug: p.slug,
    title: p.data.title,
    description: p.data.description,
    pubDate: p.data.pubDate,
    author: p.data.author,
    image: p.data.image,
    tags: p.data.tags,
  }));
---

<BaseLayout title={pageContentEntry.data.seo_title || "Blog | Kauai Hot Yoga"} description={pageContentEntry.data.seo_description || "Tips, stories, and guides to support your yoga journey from the team at Kauai Hot Yoga."} currentPath="/blog">
  <BlogPage
    posts={posts}
    heroDesktopSrc={pageHeroesEntry.data.blog.desktop}
    heroMobileSrc={pageHeroesEntry.data.blog.mobile}
    heroEyebrow={pageContentEntry.data.hero_eyebrow}
    heroTitle={pageContentEntry.data.hero_title}
    heroSubtitle={pageContentEntry.data.hero_subtitle}
  />
</BaseLayout>
