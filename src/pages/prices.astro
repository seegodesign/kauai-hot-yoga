---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PricingPage from "../views/pricing.astro";

const pageHeroesEntry = await getEntry("pageHeroSettings", "main");
if (!pageHeroesEntry) throw new Error("Missing content: pageHeroSettings/main.yml");

const pageContentEntry = await getEntry("pricingPage", "main");
if (!pageContentEntry) throw new Error("Missing content: pricingPage/main.yml");

const planEntries = await getCollection("pricingPlans");
const plans = planEntries
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((e) => e.data);

const specialEntries = await getCollection("pricingSpecials");
const specials = specialEntries
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((e) => e.data);

const faqEntries = await getCollection("faq");
const faqs = faqEntries
  .filter((e) => e.data.category === "Pricing")
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((e) => ({ question: e.data.question, answer: e.data.answer }));

const coldPlungeEntries = await getCollection("coldPlungePricing");
const coldPlungePlans = coldPlungeEntries
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((e) => e.data);

const breathworkEntries = await getCollection("breathworkPricing");
const breathworkPlans = breathworkEntries
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((e) => e.data);
---

<BaseLayout
  title={pageContentEntry.data.seo_title || "Hot Yoga Pricing & Memberships in Kauai | Kauai Hot Yoga"}
  description={pageContentEntry.data.seo_description || "Drop-in classes, class packs, and monthly memberships at Kauai Hot Yoga in Lihue, Hawaii. Traveler weekly passes and local intro month deals available."}
  currentPath="/prices">
  <PricingPage pageContent={pageContentEntry.data} plans={plans} specials={specials} faqs={faqs} coldPlungePlans={coldPlungePlans} breathworkPlans={breathworkPlans} heroDesktopSrc={pageHeroesEntry.data.pricing.desktop} heroMobileSrc={pageHeroesEntry.data.pricing.mobile} />
</BaseLayout>