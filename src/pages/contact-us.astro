---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ContactPage } from "../views/contact";

const settingsEntry = await getEntry("settings", "main");
if (!settingsEntry) throw new Error("Missing content: settings/main.yml");

const pageHeroesEntry = await getEntry("pageHeroSettings", "main");
if (!pageHeroesEntry) throw new Error("Missing content: pageHeroSettings/main.yml");
---

<BaseLayout title="Contact | Kauai Hot Yoga" description="Get in touch with Kauai Hot Yoga. Find our address, phone number, email, and studio hours." currentPath="/contact-us">
  <ContactPage info={settingsEntry.data} heroDesktopSrc={pageHeroesEntry.data.contact.desktop} heroMobileSrc={pageHeroesEntry.data.contact.mobile} client:visible />
</BaseLayout>
