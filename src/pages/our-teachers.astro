---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TeachersPage from "../views/teachers.astro";

const teacherEntries = await getCollection("teachers");
const teachers = teacherEntries
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((e) => e.data);

const pageHeroesEntry = await getEntry("pageHeroSettings", "main");
if (!pageHeroesEntry) throw new Error("Missing content: pageHeroSettings/main.yml");

const pageContentEntry = await getEntry("teachersPage", "main");
if (!pageContentEntry) throw new Error("Missing content: teachersPage/main.yml");
---

<BaseLayout
  title={pageContentEntry.data.seo_title || "Our Teachers | Kauai Hot Yoga"}
  description={pageContentEntry.data.seo_description || "Meet the certified hot yoga instructors at Kauai Hot Yoga in Lihue, Hawaii. Experienced teachers in Bikram, Vinyasa, Pilates, breathwork, and more."}
  currentPath="/our-teachers">
  <TeachersPage
    teachers={teachers}
    heroDesktopSrc={pageHeroesEntry.data.teachers.desktop}
    heroMobileSrc={pageHeroesEntry.data.teachers.mobile}
    heroEyebrow={pageContentEntry.data.hero_eyebrow}
    heroTitle={pageContentEntry.data.hero_title}
    heroSubtitle={pageContentEntry.data.hero_subtitle}
  />
</BaseLayout>
