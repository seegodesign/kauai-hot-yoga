---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { TeachersPage } from "../views/teachers";

const teacherEntries = await getCollection("teachers");
const teachers = teacherEntries
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((e) => e.data);

const pageHeroesEntry = await getEntry("pageHeroSettings", "main");
if (!pageHeroesEntry) throw new Error("Missing content: pageHeroSettings/main.yml");
---

<BaseLayout
  title="Our Teachers | Kauai Hot Yoga"
  description="Meet the certified hot yoga instructors at Kauai Hot Yoga in Lihue, Hawaii. Experienced teachers in Bikram, Vinyasa, Pilates, breathwork, and more."
  currentPath="/our-teachers">
  <TeachersPage teachers={teachers} heroDesktopSrc={pageHeroesEntry.data.teachers.desktop} heroMobileSrc={pageHeroesEntry.data.teachers.mobile} client:visible />
</BaseLayout>
